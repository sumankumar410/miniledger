# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/miniledger?schema=public"

# JWT Authentication
JWT_SECRET="miniledger_jwt_super_secret_key_12345_change_in_production"
JWT_EXPIRES_IN="7d"

# CORS Configuration
CLIENT_URL="http://localhost:3000"

# Optional Twilio SMS Configuration (If omitted or empty, OTP is logged to backend terminal)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
