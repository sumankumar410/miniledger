generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LoanType {
  LENT
  BORROWED
}

enum LoanStatus {
  ACTIVE
  OVERDUE
  SETTLED
}

enum InterestMethod {
  NONE
  SIMPLE
  REDUCING_BALANCE
}

enum RepaymentFrequency {
  ONE_TIME
  WEEKLY
  MONTHLY
  CUSTOM
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  OTHER
}

enum ReminderChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

model User {
  id          String   @id @default(uuid())
  phoneNumber String   @unique
  name        String?
  email       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  friends       Friend[]
  loans         Loan[]
  payments      Payment[]
  reminders     Reminder[]
  notifications Notification[]

  @@map("users")
}

model Friend {
  id          String   @id @default(uuid())
  userId      String
  name        String
  phoneNumber String?
  email       String?
  notes       String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loans       Loan[]

  @@index([userId])
  @@index([userId, isArchived])
  @@index([name])
  @@map("friends")
}

model Loan {
  id                 String             @id @default(uuid())
  userId             String
  friendId           String
  type               LoanType           @default(LENT)
  principalAmount    Decimal            @db.Decimal(12, 2)
  loanDate           DateTime           @default(now())
  dueDate            DateTime?
  annualInterestRate Decimal            @default(0) @db.Decimal(5, 2)
  interestMethod     InterestMethod     @default(NONE)
  repaymentFrequency RepaymentFrequency @default(ONE_TIME)
  status             LoanStatus         @default(ACTIVE)
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  friend             Friend             @relation(fields: [friendId], references: [id], onDelete: Restrict)
  payments           Payment[]
  reminders          Reminder[]

  @@index([userId])
  @@index([friendId])
  @@index([userId, status])
  @@index([userId, type])
  @@index([userId, dueDate])
  @@map("loans")
}

model Payment {
  id                   String        @id @default(uuid())
  userId               String
  loanId               String
  amount               Decimal       @db.Decimal(12, 2)
  paymentDate          DateTime      @default(now())
  paymentMethod        PaymentMethod @default(UPI)
  transactionReference String?
  receiptUrl           String?
  notes                String?
  idempotencyKey       String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  loan                 Loan          @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([loanId])
  @@index([paymentDate])
  @@map("payments")
}

model Reminder {
  id               String          @id @default(uuid())
  userId           String
  loanId           String
  reminderDateTime DateTime
  reminderType     String
  channel          ReminderChannel @default(IN_APP)
  status           ReminderStatus  @default(PENDING)
  sentAt           DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  loan             Loan            @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([loanId])
  @@index([status, reminderDateTime])
  @@map("reminders")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  loanId    String?
  title     String
  message   String
  type      String    @default("INFO")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, readAt])
  @@map("notifications")
}
